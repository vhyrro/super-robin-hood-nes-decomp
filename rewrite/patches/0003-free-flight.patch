 lda PLAYER_X_LOW
 sta PREVIOUS_PLAYER_X_LOW
 lda PLAYER_X_LOW + 1
@@ -314,6 +315,85 @@
 beq floorfound
 @ontopofladder_skip_if_not_equal:
 rts
+freefly:
+lda PLAYER_X_LOW
+sta PREVIOUS_PLAYER_X_LOW
+lda PLAYER_X_LOW + 1
+sta PREVIOUS_PLAYER_X_LOW + 1
+lda PLAYER_Y
+sta PREVIOUS_PLAYER_Y
+
+lda #128
+sta PLAYER_GRAVITY
+lda #0
+sta PLAYER_JUMPING
+sta PLAYER_ON_LADDER
+sta PLAYER_CROUCHING
+sta PLAYER_JUST_JUMPED
+sta PLAYER_LADDER_COUNTER
+sta PLAYER_BEHIND_BACKGROUND
+sta RUN_ANIMATION_COUNTER
+lda #255
+sta PLAYER_ANIMATION
+
+lda JOYPAD_STATE
+and #BUTTON_RIGHT_MASK
+beq @freefly_no_right
+lda #1
+sta PLAYER_FACING
+sta OLD_PLAYER_FACING
+lda PLAYER_X_LOW
+clc
+adc #3
+sta PLAYER_X_LOW
+bcc @freefly_no_right
+inc PLAYER_X_LOW + 1
